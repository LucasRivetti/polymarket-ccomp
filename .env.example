# Copie este arquivo para .env e preencha com os dados do Neon
# (Neon Console > seu projeto > Connect). NUNCA commite o .env.

# Conexão COM pooler (o host tem "-pooler"). Usada pela aplicação.
# Em ambiente serverless (Vercel), cada requisição pode abrir uma conexão nova;
# sem o pooler o banco esgota o limite de conexões em produção.
DATABASE_URL="postgresql://USUARIO:SENHA@ep-xxxxxx-pooler.REGIAO.aws.neon.tech/neondb?sslmode=require"

# Conexão DIRETA (sem "-pooler" no host). Usada só pela CLI do Prisma (migrations/studio).
DIRECT_URL="postgresql://USUARIO:SENHA@ep-xxxxxx.REGIAO.aws.neon.tech/neondb?sslmode=require"
