# Exige o padrão "PCC-XX: mensagem" (merges e reverts gerados pelo Git passam direto)
msg=$(head -n1 "$1")
if echo "$msg" | grep -Eq '^(Merge|Revert|fixup!|squash!)'; then
  exit 0
fi
if ! echo "$msg" | grep -Eq '^PCC-[0-9]+: .+'; then
  echo ""
  echo "Mensagem de commit fora do padrão: \"$msg\""
  echo "Use: PCC-XX: mensagem no imperativo   (ex.: PCC-12: Adiciona tela de login)"
  echo ""
  exit 1
fi
